# Upstash Redis / Vercel KV — used for the usage counter.
# If connecting via Vercel Marketplace (Upstash Redis integration):
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Or if using legacy Vercel KV credentials:
KV_REST_API_URL=
KV_REST_API_TOKEN=


# Stats API authentication (optional)
# When set, /api/stats returns full tool breakdown only with: Authorization: Bearer <token>
# Without this token, only the grand total is public.
STATS_API_TOKEN=
